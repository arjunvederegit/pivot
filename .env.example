# --- Database ---
# Local development defaults to SQLite. docker-compose and production use PostgreSQL.
DATABASE_URL=sqlite:///./tradelab.db
# DATABASE_URL=postgresql+psycopg://tradelab:tradelab@localhost:5432/tradelab

# --- Cache ---
# Optional. When unset, an in-process TTL cache is used (single-instance only).
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
# Token required for POST /api/v1/admin/* endpoints. Leave empty to disable admin routes.
ADMIN_TOKEN=

# --- nba_api / NBA.com client safeguards ---
NBA_API_TIMEOUT_SECONDS=45
NBA_API_MAX_RETRIES=4
NBA_API_MIN_REQUEST_INTERVAL_SECONDS=0.75
NBA_API_MAX_CONCURRENCY=2
NBA_API_CACHE_TTL_SECONDS=3600
NBA_API_STALE_AFTER_SECONDS=86400
NBA_API_USER_AGENT=
NBA_API_HTTP_PROXY=

# --- BALLDONTLIE (optional; server-side only) ---
# Pivot runs fully without this. Leave the key empty unless you have started a BALLDONTLIE
# trial or subscription yourself. Never commit a real key; .env is gitignored.
BALLDONTLIE_API_KEY=
# free | trial | all_star | goat | all_access  (sets request pacing only: 5/5/60/600/600 per minute)
BALLDONTLIE_TIER=trial
# BALLDONTLIE_BASE_URL=https://api.balldontlie.io
# BALLDONTLIE_API_PREFIX=/nba/v1

# --- Seasons ---
# The season treated as "current" for rosters/stats (NBA season string).
CURRENT_SEASON=2025-26
# Historical seasons ingested for modeling (comma-separated, oldest first).
HISTORY_SEASONS=2023-24,2024-25,2025-26
# League year whose cap parameters govern trade legality. Deliberately AHEAD of
# CURRENT_SEASON: a trade executed in July 2026 falls under the 2026-27 cap even
# though 2025-26 is the last completed stats season. Do not unify the two.
CAP_LEAGUE_YEAR=2026-27

# --- Background scheduler (docker compose `worker` service; `make worker` locally) ---
# Roster/standings refresh cadence and stats refresh cadence, in hours.
SYNC_ROSTERS_EVERY_HOURS=6
SYNC_STATS_EVERY_HOURS=24

# --- Contract / salary provider (optional; nba_api does not provide contracts) ---
# Supported: "" (none), "file" (user CSV; see data/contracts/README.md),
# "bbref_snapshot" (user-downloaded basketball-reference.com contracts page saved to
# data/imports/contracts/players.html — no live scraping)
CONTRACT_DATA_PROVIDER=
CONTRACT_DATA_API_KEY=
CONTRACT_DATA_FILE=

# --- Local media assets (user-supplied datasets; gitignored, served by the backend) ---
# Defaults: <repo>/nbalogos and <repo>/nbaplayerimages
ASSET_LOGOS_DIR=
ASSET_PLAYER_IMAGES_DIR=

# --- Kaggle historical dataset (kagglehub cache override; public dataset, no auth) ---
KAGGLE_DATA_DIR=

# --- Injury provider (optional; none bundled) ---
INJURY_DATA_PROVIDER=

# --- Live game polling (cdn.nba.com). Disabled by default; enable only in season. ---
LIVE_DATA_ENABLED=false

# --- Optional LLM prose enhancement for reports (never computes values) ---
ANTHROPIC_API_KEY=

# --- Ask Pivot / Pivot Intelligence (EXPERIMENTAL; fictional corpus only) ---
# Off by default. Local development only: requires `pip install -e ".[dev,assistant]"`
# in backend/ and a local Ollama (https://ollama.com) with the two models pulled.
# See docs/pivot/assistant-v2-runbook.md. Never enable on a public deployment.
ASSISTANT_ENABLED=false
# With Ask Pivot on, its routes answer only loopback requests (peer, X-Forwarded-For, Host and
# X-Forwarded-Host) unless this is true. Not real auth.
ASSISTANT_ALLOW_REMOTE=false
# Accept dev-only experiment options (prompt/retrieval variants, k) on the ask route.
ASSISTANT_DEV_OPTIONS=false
OLLAMA_BASE_URL=http://localhost:11434
ASSISTANT_CHAT_MODEL=qwen3.5:2b
ASSISTANT_EMBEDDING_MODEL=nomic-embed-text
ASSISTANT_REQUEST_TIMEOUT_SECONDS=150
ASSISTANT_MAX_IN_FLIGHT=1

# --- LangSmith tracing for Ask Pivot (opt-in) ---
# PRIVACY: with tracing on, prompts, retrieved (fictional) evidence and answers are sent to
# LangSmith's servers even though the model runs locally. Leave off unless you mean it.
# Tracing needs Pivot's own switch AND a key. The SDK's LANGSMITH_TRACING / LANGSMITH_PROJECT
# (or LANGCHAIN_TRACING_V2) are deliberately NOT read: exporting them for another project
# neither turns Ask Pivot's tracing on nor redirects its runs.
ASSISTANT_TRACING=false
ASSISTANT_LANGSMITH_PROJECT=pivot-intelligence-v2
# The key is also what `python -m scripts.eval_rag hosted` (an explicit upload) needs.
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# Shows the experimental Ask Pivot nav item and /assistant route. Inlined at build time, and
# Next.js reads env files from frontend/, not the repo root: for local dev either export it
# (`NEXT_PUBLIC_ASSISTANT_ENABLED=true npm run dev`) or put it in frontend/.env.local.
NEXT_PUBLIC_ASSISTANT_ENABLED=false
